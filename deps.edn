{:paths ["src" "resources"]
 :deps {org.clojure/clojure            {:mvn/version "1.12.4"}
        org.clojure/core.async         {:mvn/version "1.8.741"}
        clj-fuzzy/clj-fuzzy            {:mvn/version "0.4.1"}
        com.cnuernber/charred          {:mvn/version "1.037"}
        com.taoensso/tempura           {:mvn/version "1.5.4"}
        com.taoensso/timbre            {:mvn/version "6.8.0"}
        dev.data-star.clojure/brotli   {:mvn/version "1.0.0-RC7"}
        dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC7"}
        dev.data-star.clojure/sdk      {:mvn/version "1.0.0-RC7"}
        dev.onionpancakes/chassis      {:mvn/version "1.0.365"}
        expound/expound                {:mvn/version "0.9.0"}
        io.github.tonsky/fast-edn      {:mvn/version "1.1.3"}
        io.nayuki/qrcodegen            {:mvn/version "1.8.0"}
        io.replikativ/datahike         {:mvn/version "0.7.1624"}
        metosin/reitit                 {:mvn/version "0.10.0"}
        mount/mount                    {:mvn/version "0.1.23"}}
 :aliases {:dev {:extra-deps {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.7.0"}
                              criterium/criterium                      {:mvn/version "0.4.6"}
                              ring/ring-devel                          {:mvn/version "1.15.0-beta1"}}
                 :jvm-opts ["-Dapp.env=dev"
                            "--enable-native-access=ALL-UNNAMED"
                            "-Duser.timezone=UTC"
                            "-XX:+UseZGC"
                            "-Djdk.attach.allowAttachSelf"
                            "-XX:+EnableDynamicAgentLoading"]}
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.11" :git/sha "c6c670a"}}
                   :ns-default build}
           :repl {:extra-paths ["dev"]
                  :extra-deps  {nrepl/nrepl                 {:mvn/version "1.5.2"}
                                cider/cider-nrepl           {:mvn/version "0.58.0"}
                                io.github.tonsky/clj-reload {:mvn/version "1.0.0"}}
                  :main-opts ["--main" "nrepl.cmdline"
                              "--middleware" "[cider.nrepl/cider-middleware]"
                              "--interactive"]}
           :test {:extra-paths ["test/src"]
                  :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                                ring/ring-mock                       {:mvn/version "0.6.2"}}
                  :main-opts   ["-m" "cognitect.test-runner"]
                  :exec-fn     cognitect.test-runner.api/test}
           :test-refresh {:extra-paths ["test/src"]
                          :extra-deps {com.jakemccrary/test-refresh {:mvn/version "0.26.0"}}
                          :main-opts ["-m" "com.jakemccrary.test-refresh"]}}}
